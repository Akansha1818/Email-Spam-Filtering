# Copy to gmail.env (git-ignored) on the MASTER Mac and fill in there.
# NEVER put real values in THIS file - it is committed to GitHub.
# The password is a Google "App Password" (16 letters), NOT your normal Gmail password:
#   1. Turn on 2-Step Verification:  https://myaccount.google.com/security
#   2. Create an App Password:       https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
