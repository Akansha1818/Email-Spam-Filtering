<?xml version="1.0" encoding="UTF-8"?>
<!-- Rendered by scripts/configure.sh -> $HADOOP_HOME/etc/hadoop/hdfs-site.xml -->
<configuration>
  <!-- Every block is stored on both workers -->
  <property><name>dfs.replication</name><value>2</value></property>

  <property><name>dfs.namenode.name.dir</name><value>file://@BIG@/data/hdfs/name</value></property>
  <property><name>dfs.datanode.data.dir</name><value>file://@BIG@/data/hdfs/data</value></property>

  <!-- Listen on all interfaces; NameNode UI on :9870 -->
  <property><name>dfs.namenode.rpc-bind-host</name><value>0.0.0.0</value></property>
  <property><name>dfs.namenode.http-address</name><value>0.0.0.0:9870</value></property>

  <!-- Laptops on a hotspot have no reverse DNS: register DataNodes by IP -->
  <property><name>dfs.namenode.datanode.registration.ip-hostname-check</name><value>false</value></property>
  <property><name>dfs.datanode.hostname</name><value>@THIS_IP@</value></property>

  <!-- Different macOS users on each laptop: no HDFS permission checks (lab setup) -->
  <property><name>dfs.permissions.enabled</name><value>false</value></property>

  <!-- Small 2-DataNode cluster: keep writing if one DataNode drops out -->
  <property><name>dfs.client.block.write.replace-datanode-on-failure.policy</name><value>NEVER</value></property>
  <property><name>dfs.namenode.safemode.min.datanodes</name><value>0</value></property>
  <property><name>dfs.namenode.heartbeat.recheck-interval</name><value>60000</value></property>
</configuration>
