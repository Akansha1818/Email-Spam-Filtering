# Copy to cluster.env on EVERY Mac and edit.  (cluster.env is git-ignored.)

# IP of the master Mac (on the master run:  ipconfig getifaddr en0)
MASTER_IP=192.168.0.88

# Resources this Mac gives to Spark when it runs as a worker
#   16 GB MacBook Air worker ->  WORKER_CORES=4  WORKER_MEMORY=3g
#    8 GB Mac worker        ->  WORKER_CORES=2  WORKER_MEMORY=2g
WORKER_CORES=4
WORKER_MEMORY=3g

# Optional: force this Mac's IP if auto-detection (en0) picks the wrong one
# THIS_IP=192.168.0.90
